# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres (docker compose maps it to 5433)
DATABASE_URL=postgresql://lodgemart:lodgemart@localhost:5433/lodgemart_dev?schema=public
# Database TLS: off for local docker. Production (Supabase): verify + DATABASE_CA_CERT,
# and MIGRATE_DATABASE_URL = same URL with ?sslmode=require (see docs/DEPLOYMENT.md)
DATABASE_SSL=off
DATABASE_CA_CERT=
MIGRATE_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173,https://lodge-mart.vercel.app

# Monnify (by Moniepoint) — use SANDBOX credentials (app.monnify.com → Developer →
# API Keys & Contracts). A live key (MK_PROD_) or the live API is refused unless
# NODE_ENV=production. Blank = bank transfer, wallet funding and payouts are off.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Your Monnify wallet account number (Disbursements page) — vendor payouts are sent from it
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Where students land after checkout (frontend page)
MONNIFY_REDIRECT_URL=http://localhost:5173/orders
# Unpaid bank-transfer orders release their stock after this many minutes
PENDING_PAYMENT_TTL_MINUTES=30

# Cloudinary (stall pickup photos): Dashboard > API Keys > "API environment variable"
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
