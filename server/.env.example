# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres (docker compose maps it to 5433)
DATABASE_URL=postgresql://lodgemart:lodgemart@localhost:5433/lodgemart_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173,https://lodge-mart.vercel.app

# Phase 5+ (leave blank until then)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
CLOUDINARY_URL=
