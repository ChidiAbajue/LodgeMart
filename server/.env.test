# Test-only settings for the local docker services. Contains no real secrets.
NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://lodgemart:lodgemart@localhost:5433/lodgemart_test?schema=public
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=test-only-secret-not-used-anywhere-real-0123456789abcdef
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:5173
# Fake test-only Monnify/Cloudinary values. Tests mock Monnify HTTP; nothing is ever sent to these.
MONNIFY_API_KEY=MK_TEST_FAKEKEYFORAUTOMATEDTESTS
MONNIFY_SECRET_KEY=fake_monnify_test_secret_000000
MONNIFY_CONTRACT_CODE=1234567890
MONNIFY_WALLET_ACCOUNT_NUMBER=9999999999
MONNIFY_BASE_URL=https://monnify.mock.local
MONNIFY_REDIRECT_URL=http://localhost:5173/orders
CLOUDINARY_URL=cloudinary://111111111111111:fake_test_secret@lodgemart-test
